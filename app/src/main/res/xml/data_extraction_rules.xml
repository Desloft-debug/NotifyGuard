<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Журнал и настройки не выгружаются ни в облачный бэкап,
         ни при переносе на другое устройство. -->
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
